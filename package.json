{
  "name": "vc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --experimental-strip-types --import ./tests/register-tsx.mts --test tests/story.test.ts tests/story-components.test.ts tests/legacy-components.test.ts",
    "test:browser": "playwright test",
    "lint:story": "eslint app/page.tsx app/layout.tsx components/story lib/story.ts lib/restaurants.ts lib/restaurant-state.ts lib/validation.ts tests playwright.config.ts next.config.ts --max-warnings=0",
    "typecheck:story": "tsc -p tsconfig.story.json",
    "build:static": "STORY_STATIC_EXPORT=1 next build --webpack && node --experimental-strip-types scripts/prepare-static.mts",
    "preview:cloudflare": "CLOUDFLARE_CF_FETCH_ENABLED=false WRANGLER_SEND_METRICS=false wrangler dev --local --ip 127.0.0.1 --port 3100",
    "test:hosting": "playwright test --config playwright.hosting.config.ts"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.35.0",
    "@tsparticles/engine": "^3.9.1",
    "@tsparticles/react": "^3.0.0",
    "@tsparticles/slim": "^3.9.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.24",
    "geist": "1.5.1",
    "gsap": "^3.13.0",
    "lenis": "^1.3.13",
    "lucide-react": "^0.552.0",
    "mapbox-gl": "^3.16.0",
    "maplibre-gl": "6.15.0",
    "motion": "^12.23.24",
    "next": "16.4.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-intersection-observer": "^10.0.0",
    "react-map-gl": "8.1.3",
    "recharts": "^3.3.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/mapbox-gl": "^3.4.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "wrangler": "4.151.2"
  }
}
